{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/Containerfile/"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "configMigration": true
}
